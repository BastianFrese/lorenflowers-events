@{
    ViewData["Title"] = "Anmelden";
    Layout = null;
}

<!DOCTYPE html>
<html lang="de">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Anmelden - Loren Flowers Events</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;500;600;700&family=Lato:wght@300;400;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <style>
        .auth-page {
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            background: linear-gradient(135deg, #1a1a2e 0%, #16213e 50%, #0f3460 100%);
        }
        .auth-card {
            max-width: 420px;
            width: 100%;
            border: none;
            border-radius: 1.25rem;
            overflow: hidden;
            box-shadow: 0 20px 60px rgba(0,0,0,.3);
        }
        .auth-header {
            background: linear-gradient(135deg, #2d1b3d 0%, #1a1a2e 100%);
            color: #fff;
            text-align: center;
            padding: 2rem 1.5rem 1.5rem;
        }
        .auth-header h2 { font-family: 'Playfair Display', serif; font-weight: 600; }
        .auth-body { padding: 2rem 1.5rem; }
        .brand-icon { font-size: 2.5rem; display: block; margin-bottom: .5rem; }
        .btn-primary-custom {
            background: linear-gradient(135deg, #2d1b3d, #0f3460);
            border: none;
            border-radius: .75rem;
            font-weight: 600;
            padding: .75rem;
            transition: opacity .2s;
        }
        .btn-primary-custom:hover { opacity: .9; }
    </style>
</head>
<body class="auth-page">
    <div class="auth-card card">
        <div class="auth-header">
            <span class="brand-icon">🌸</span>
            <h2 class="mb-1">Admin-Bereich</h2>
            <p class="mb-0 opacity-75">Loren Flowers Events</p>
        </div>
        <div class="auth-body">
            @if (!ViewData.ModelState.IsValid)
            {
                <div class="alert alert-danger py-2">
                    <i class="bi bi-exclamation-triangle me-2"></i>
                    @Html.ValidationSummary(false, "", new { @class = "mb-0" })
                </div>
            }

            <form asp-action="Login" asp-controller="Account" method="post">
                <input type="hidden" name="returnUrl" value="@ViewBag.ReturnUrl" />

                <div class="mb-3">
                    <label class="form-label">E-Mail</label>
                    <div class="input-group">
                        <span class="input-group-text bg-white" style="border-radius: 0.75rem 0 0 0.75rem;"><i class="bi bi-envelope"></i></span>
                        <input type="email" name="email" class="form-control" placeholder="E-Mail" autofocus required style="border-radius: 0 0.75rem 0.75rem 0;">
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label">Passwort</label>
                    <div class="input-group">
                        <span class="input-group-text bg-white" style="border-radius: 0.75rem 0 0 0.75rem;"><i class="bi bi-lock"></i></span>
                        <input type="password" name="password" class="form-control" placeholder="Passwort" required style="border-radius: 0 0.75rem 0.75rem 0;">
                    </div>
                </div>

                <div class="form-check mb-4">
                    <input type="checkbox" name="rememberMe" value="true" class="form-check-input" id="rememberMe">
                    <label class="form-check-label" for="rememberMe">Angemeldet bleiben</label>
                </div>

                <div class="d-grid mb-3">
                    <button type="submit" class="btn btn-primary-custom btn-lg text-white w-100">
                        <i class="bi bi-box-arrow-in-right me-2"></i>Anmelden
                    </button>
                </div>
            </form>

            <div class="text-center">
                <a href="/" class="text-muted small"><i class="bi bi-arrow-left me-1"></i>Zurück zur Events-Seite</a>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
