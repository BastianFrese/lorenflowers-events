@model LorenFlowers.Events.Models.EventInfo
@inject Microsoft.Extensions.Configuration.IConfiguration Configuration
@{
    ViewData["Title"] = $"{Model.Title} – Loren Flowers Events";
    var contactEmail = Configuration["ContactEmail"] ?? "loren@loren-flowers.de";
    var subject = Uri.EscapeDataString($"Anfrage: {Model.Title}");
}

@* ===== HERO ===== *@
<section class="hero-section">
    <div class="container">
        <div class="row align-items-center g-5">
            <div class="col-lg-7 hero-content">
                <span class="hero-badge"><i class="bi @Model.Icon"></i> @Model.Title.ToUpper()</span>
                <h1 class="hero-title">
                    @Model.Title<br />
                    <span class="highlight">@Model.Subtitle</span>
                </h1>
                <p class="hero-subtitle">@Model.Lead</p>
                <div class="d-flex flex-wrap gap-3">
                    <a href="mailto:@contactEmail?subject=@subject" class="btn-lf-primary">
                        <i class="bi bi-envelope me-2"></i>Jetzt anfragen
                    </a>
                    <a href="#pakete" class="btn-lf-outline">Pakete ansehen</a>
                </div>
            </div>
            <div class="col-lg-5 d-none d-lg-block">
                <div class="hero-image-wrapper">
                    <div class="hero-circle hero-circle-lg"></div>
                    <div class="hero-circle hero-circle-sm"></div>
                    <div class="hero-float-card">
                        <span class="fcard-icon" style="color:var(--primary);"><i class="bi @Model.Icon"></i></span>
                        <div class="fcard-text">
                            <strong>@Model.Title</strong>
                            <span>Handgebunden mit Liebe</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

@* ===== BESCHREIBUNG + HIGHLIGHTS ===== *@
<section class="categories-section">
    <div class="container">
        <div class="row g-5 align-items-start">
            <div class="col-lg-7">
                <span class="section-label">Über @Model.Title</span>
                <h2 class="section-title">Was wir für Sie gestalten</h2>
                <p style="color:var(--text-muted);line-height:1.8;font-size:1.05rem;">@Model.Description</p>
            </div>
            <div class="col-lg-5">
                <div style="background:var(--bg-surface);padding:2rem;border-radius:var(--radius);box-shadow:var(--shadow);">
                    <h5 style="margin-bottom:1.25rem;"><i class="bi bi-check2-circle me-2" style="color:var(--primary);"></i>Unsere Leistungen</h5>
                    <ul style="list-style:none;padding:0;margin:0;">
                        @foreach (var h in Model.Highlights)
                        {
                            <li style="padding:0.55rem 0;border-bottom:1px solid var(--border-subtle);color:var(--text-dark);">
                                <i class="bi bi-flower1 me-2" style="color:var(--primary);"></i>@h
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </div>
    </div>
</section>

@* ===== PAKETE ===== *@
<section id="pakete" class="highlights-section">
    <div class="container">
        <div class="text-center mb-5">
            <span class="section-label">Unsere Pakete</span>
            <h2 class="section-title">Auswahl &amp; Preise</h2>
        </div>
        <div class="row g-4">
            @foreach (var p in Model.Packages)
            {
                <div class="col-md-6 col-lg-4">
                    <div class="product-card h-100" style="@(p.IsFeatured ? "border:2px solid var(--primary);" : "")">
                        <div class="product-card-body" style="display:flex;flex-direction:column;height:100%;">
                            @if (p.IsFeatured)
                            {
                                <span class="product-badge" style="position:static;align-self:flex-start;margin-bottom:0.75rem;">Beliebt</span>
                            }
                            <h5 class="product-name">@p.Name</h5>
                            <p class="product-price" style="margin:0.25rem 0 1rem;">@p.PriceFrom</p>
                            <ul style="list-style:none;padding:0;margin:0 0 1.5rem 0;flex-grow:1;">
                                @foreach (var item in p.Items)
                                {
                                    <li style="padding:0.4rem 0;color:var(--text-muted);">
                                        <i class="bi bi-check2 me-2" style="color:var(--primary);"></i>@item
                                    </li>
                                }
                            </ul>
                            <a href="mailto:@contactEmail?subject=@subject - @Uri.EscapeDataString(p.Name)" class="btn-product">Anfragen</a>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

@* ===== CTA ===== *@
<section class="categories-section">
    <div class="container">
        <div class="text-center" style="background:var(--bg-surface);padding:3rem 1.5rem;border-radius:var(--radius);box-shadow:var(--shadow);">
            <span class="section-label">Persönlich &amp; Individuell</span>
            <h2 class="section-title mb-3">Ihr Anlass, unsere Blumen</h2>
            <p style="color:var(--text-muted);max-width:640px;margin:0 auto 1.5rem;">
                Sie haben spezielle Wünsche oder ein Konzept im Kopf? Wir freuen uns auf Ihre Nachricht
                und besprechen alle Details persönlich mit Ihnen.
            </p>
            <a href="mailto:@contactEmail?subject=@subject" class="btn-lf-primary">
                <i class="bi bi-envelope me-2"></i>Jetzt unverbindlich anfragen
            </a>
        </div>
    </div>
</section>
