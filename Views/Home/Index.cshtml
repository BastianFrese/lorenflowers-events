@model IReadOnlyList<LorenFlowers.Events.Models.EventInfo>
@inject Microsoft.Extensions.Configuration.IConfiguration Configuration
@{
    ViewData["Title"] = "Loren Flowers Events – Florale Begleitung für jeden Anlass";
    var shopUrl = Configuration["ShopUrl"] ?? "https://loren-flowers.shop";
}

@* ===== HERO ===== *@
<section class="hero-section">
    <div class="container">
        <div class="row align-items-center g-5">
            <div class="col-lg-7 hero-content">
                <span class="hero-badge"><i class="bi bi-flower1"></i> EVENTS &amp; BESONDERE ANLÄSSE</span>
                <h1 class="hero-title">
                    Florale Begleitung<br />
                    <span class="highlight">für jeden Lebensmoment</span>
                </h1>
                <p class="hero-subtitle">
                    Ob Hochzeit, Trauerfeier, Kommunion, Konfirmation, Workshop oder Markt –
                    wir gestalten Ihre Veranstaltung mit handgebundener Floristik aus über 20 Jahren Erfahrung.
                </p>
                <div class="d-flex flex-wrap gap-3">
                    <a href="#anlaesse" class="btn-lf-primary">Anlässe entdecken</a>
                    <a href="@shopUrl" target="_blank" rel="noopener" class="btn-lf-outline">Zum Online-Shop</a>
                </div>
            </div>
            <div class="col-lg-5 d-none d-lg-block">
                <div class="hero-image-wrapper">
                    <div class="hero-circle hero-circle-lg"></div>
                    <div class="hero-circle hero-circle-sm"></div>
                    <div class="hero-float-card">
                        <span class="fcard-icon" style="color:var(--primary);"><i class="bi bi-suit-heart-fill"></i></span>
                        <div class="fcard-text">
                            <strong>Persönliche Beratung</strong>
                            <span>Individuell, einfühlsam, erfahren</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

@* ===== ANLÄSSE GRID ===== *@
<section id="anlaesse" class="categories-section">
    <div class="container">
        <div class="text-center mb-5">
            <span class="section-label">Unsere Leistungen</span>
            <h2 class="section-title">Anlässe &amp; Events</h2>
        </div>
        <div class="row g-4">
            @foreach (var ev in Model)
            {
                <div class="col-sm-6 col-lg-4">
                    <a asp-controller="Events" asp-action="Detail" asp-route-slug="@ev.Slug" class="product-card text-decoration-none d-block h-100">
                        <div class="product-card-img d-flex align-items-center justify-content-center" style="background:linear-gradient(135deg,var(--primary-light),var(--bg-surface-alt));min-height:180px;">
                            <i class="bi @ev.Icon" style="font-size:4rem;color:var(--primary);"></i>
                        </div>
                        <div class="product-card-body">
                            <p class="product-category">@ev.Subtitle</p>
                            <h5 class="product-name">@ev.Title</h5>
                            <p class="product-desc">@ev.Lead</p>
                            <div class="product-footer">
                                <span class="product-price" style="font-size:0.95rem;">Mehr erfahren</span>
                                <span class="btn-product"><i class="bi bi-arrow-right"></i></span>
                            </div>
                        </div>
                    </a>
                </div>
            }
        </div>
    </div>
</section>

@* ===== CTA ===== *@
<section class="highlights-section">
    <div class="container">
        <div class="text-center" style="background:var(--bg-surface);padding:3rem 1.5rem;border-radius:var(--radius);box-shadow:var(--shadow);">
            <span class="section-label">Persönlich &amp; Individuell</span>
            <h2 class="section-title mb-3">Lassen Sie uns Ihre Veranstaltung gestalten</h2>
            <p style="color:var(--text-muted);max-width:640px;margin:0 auto 1.5rem;">
                Jede Veranstaltung ist einzigartig. Erzählen Sie uns von Ihren Wünschen –
                wir erstellen ein florales Konzept, das genau zu Ihnen passt.
            </p>
            <a href="mailto:@(Configuration["ContactEmail"] ?? "loren@loren-flowers.de")" class="btn-lf-primary">
                <i class="bi bi-envelope me-2"></i>Anfrage senden
            </a>
        </div>
    </div>
</section>
