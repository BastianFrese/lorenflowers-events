@inject Microsoft.Extensions.Configuration.IConfiguration Configuration
@{
    var shopUrl = Configuration["ShopUrl"] ?? "https://loren-flowers.shop";
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString() ?? string.Empty;
}
<!DOCTYPE html>
<html lang="de" data-theme="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Admin | Loren Flowers Events</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;600;700&family=Lato:wght@300;400;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="icon" type="image/svg+xml" href="~/images/site/logo.svg" />
    <script>var t=localStorage.getItem('lf-theme');if(t)document.documentElement.setAttribute('data-theme',t);</script>
    <style>
        .admin-navbar {
            background: linear-gradient(135deg, #2d1b3d 0%, #1a1a2e 100%);
            padding: .75rem 1rem;
        }
        .admin-brand { font-family: 'Playfair Display', serif; font-weight: 600; color: #fff !important; }
        .admin-sidebar {
            background: linear-gradient(180deg, #1a1a2e 0%, #16213e 100%);
            min-height: calc(100vh - 56px);
            position: sticky;
            top: 56px;
        }
        .admin-nav .nav-link {
            color: rgba(255,255,255,.7);
            padding: .5rem 1rem;
            border-radius: .375rem;
            margin-bottom: .125rem;
            display: flex;
            align-items: center;
            gap: .5rem;
            transition: all .2s;
        }
        .admin-nav .nav-link:hover { color: #fff; background: rgba(255,255,255,.08); }
        .admin-nav .nav-link.active { color: #fff; background: rgba(255,255,255,.15); font-weight: 600; }
        .admin-nav hr { border-color: rgba(255,255,255,.1); margin: .5rem 0; }
        .admin-nav small { font-size: .7rem; letter-spacing: .05em; }
        .admin-main-content { background: var(--bs-body-bg); }
        .stat-card { border: 0; border-radius: .75rem; box-shadow: 0 2px 8px rgba(0,0,0,.1); }
        .stat-value { font-size: 2rem; font-weight: 700; font-family: 'Playfair Display', serif; }
        .stat-icon { font-size: 2.5rem; opacity: .3; }
    </style>
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-dark admin-navbar">
        <div class="container-fluid">
            <a class="navbar-brand admin-brand d-flex align-items-center" href="/Admin">
                <i class="bi bi-flower1 me-2"></i>
                Loren Flowers Events Admin
            </a>
            <div class="d-none d-lg-flex align-items-center ms-auto gap-2">
                <a class="nav-link text-white-50" href="/" target="_blank">
                    <i class="bi bi-box-arrow-up-right me-1"></i>Events-Seite
                </a>
                <a class="nav-link text-white-50" href="@shopUrl" target="_blank">
                    <i class="bi bi-shop me-1"></i>Shop
                </a>
                <span class="nav-link text-white-50">
                    <i class="bi bi-person-circle me-1"></i>@User.Identity?.Name
                </span>
                <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                    <button type="submit" class="btn btn-outline-light btn-sm">
                        <i class="bi bi-box-arrow-right me-1"></i>Abmelden
                    </button>
                </form>
            </div>
            <button class="navbar-toggler" type="button" data-bs-toggle="offcanvas" data-bs-target="#adminMenu">
                <span class="navbar-toggler-icon"></span>
            </button>
        </div>
    </nav>

    <div class="offcanvas offcanvas-start" tabindex="-1" id="adminMenu" style="background:#1a1a2e;">
        <div class="offcanvas-header">
            <h5 class="offcanvas-title text-white"><i class="bi bi-flower1 me-2"></i>Admin</h5>
            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="offcanvas"></button>
        </div>
        <div class="offcanvas-body p-0">
            <div class="admin-nav p-3">
                <a class="nav-link @(currentAction == "Index" ? "active" : "")" href="/Admin">
                    <i class="bi bi-speedometer2"></i>Dashboard
                </a>
                <hr>
                <small class="text-muted px-3">EVENTS</small>
                <a class="nav-link" href="/Events"><i class="bi bi-calendar-event"></i>Alle Events</a>
                <hr>
                <a class="nav-link" href="/" target="_blank"><i class="bi bi-box-arrow-up-right"></i>Events-Seite</a>
                <a class="nav-link" href="@shopUrl" target="_blank"><i class="bi bi-shop"></i>Zum Shop</a>
                <hr>
                <form asp-controller="Account" asp-action="Logout" method="post" class="px-2">
                    <button type="submit" class="btn btn-outline-danger w-100">
                        <i class="bi bi-box-arrow-right me-1"></i>Abmelden
                    </button>
                </form>
            </div>
        </div>
    </div>

    <div class="container-fluid">
        <div class="row">
            <nav class="col-md-3 col-lg-2 d-none d-md-block admin-sidebar py-3">
                <div class="admin-nav">
                    <a class="nav-link @(currentAction == "Index" ? "active" : "")" href="/Admin">
                        <i class="bi bi-speedometer2"></i>Dashboard
                    </a>
                    <hr>
                    <small class="text-muted px-3">EVENTS</small>
                    <a class="nav-link" href="/Events"><i class="bi bi-calendar-event"></i>Alle Events</a>
                </div>
            </nav>

            <main class="col-12 col-md-9 ms-sm-auto col-lg-10 px-3 px-md-4 py-3 py-md-4 admin-main-content">
                @if (TempData["Success"] != null)
                {
                    <div class="alert alert-success alert-dismissible fade show" role="alert">
                        <i class="bi bi-check-circle me-2"></i>@TempData["Success"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                }
                @if (TempData["Error"] != null)
                {
                    <div class="alert alert-danger alert-dismissible fade show" role="alert">
                        <i class="bi bi-exclamation-triangle me-2"></i>@TempData["Error"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                }
                @RenderBody()
            </main>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
